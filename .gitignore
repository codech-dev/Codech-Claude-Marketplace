*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# Logs
*.log
npm-debug.log*

# Local test outputs
/tmp/
/build/
/dist/

# Anything starting with _ at root is treated as scratch work
/_*

# Local override for testing the skill before committing
*.local.md
